<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Prevents inheriting Windows-specific Visual Studio fallback paths into Linux build contexts -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>