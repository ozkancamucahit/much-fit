      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (path) (rate(feedme_feed_delivery_path_total[1m]))",
          "legendFormat": "delivery: {{path}}",
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(feedme_feed_home_merge_base_items_sum[1m])) / clamp_min(sum(rate(feedme_feed_home_merge_base_items_count[1m])), 1)",
          "legendFormat": "avg base items",
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(feedme_feed_home_merge_hot_items_sum[1m])) / clamp_min(sum(rate(feedme_feed_home_merge_hot_items_count[1m])), 1)",
          "legendFormat": "avg hot items",
          "range": true,
          "format": "time_series"
        }
