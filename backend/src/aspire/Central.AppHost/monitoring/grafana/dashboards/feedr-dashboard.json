          "legendFormat": "dlq: {{operation}}",
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (operation, status) (rate(feedme_service_errors_total[1m]))",
          "legendFormat": "error: {{operation}}/{{status}}",
          "range": true,
